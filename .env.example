# Supabase project URL and publishable key (designed for public client use with RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: invited owner email. No service-role key is needed.
PINBOT_OWNER_EMAIL=

# Server-only optional enrichment configuration. Empty means no external source grants.
# Each grant needs origin, pathPrefix, purpose, authorizationReference, expiresAt.
# Metadata grants additionally require permitsShopMyDestination; images require imagesMayBeRepublished.
PINBOT_ENRICHMENT_GRANTS=[]
# Licensed normalized catalog records; see docs/enrichment.md. No credentials in these records.
PINBOT_LICENSED_PRODUCT_FEEDS=[]
# Optional for higher Tavily Search limits. Without it, documented keyless pilot access is used.
TAVILY_API_KEY=
# Server-only image descriptions (Responses API, vision input)
OPENAI_API_KEY=
# Optional; defaults to gpt-4.1-mini
OPENAI_VISION_MODEL=

# Server-only Pinterest connection (see docs/pinterest.md).
SUPABASE_SECRET_KEY=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=
PINTEREST_TOKEN_ENCRYPTION_KEY=
# Change to standard only after Pinterest approves Standard access.
PINTEREST_ACCESS_TIER=trial

# Cloud publishing worker. Explicitly enable after a reviewed Trial test is ready.
PINBOT_PUBLISH_ENABLED=false
PINBOT_PUBLISH_OWNER_ID=
PINBOT_PUBLISH_WORKER_SECRET=
