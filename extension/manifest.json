{
  "manifest_version": 3,
  "name": "Mr. Pinbot",
  "version": "0.1.0",
  "description": "Save the exact product image you select as a Mr. Pinbot Draft.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "clipboardRead",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pinbot.annabuchy.com/capture*",
        "http://localhost:3000/capture*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Open Mr. Pinbot",
    "default_icon": {
      "16": "icons/pinbot-16.png",
      "32": "icons/pinbot-32.png",
      "48": "icons/pinbot-48.png",
      "128": "icons/pinbot-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/pinbot-16.png",
    "32": "icons/pinbot-32.png",
    "48": "icons/pinbot-48.png",
    "128": "icons/pinbot-128.png"
  },
  "host_permissions": [
    "https://pinbot.annabuchy.com/*",
    "http://localhost/*"
  ]
}
